{
  "name": "elmancod110/secure-package",
  "description": "High-assurance encrypted project package engine with authenticated V14 package integrity and a separate browser vault compatibility boundary.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ElmanCod110"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "config": {
    "allow-plugins": false,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "SecurePackage\\": "app/"
    }
  }
}
